{
  "name": "threadlens-monorepo",
  "private": true,
  "version": "0.3.1",
  "description": "Local-first observability dashboard for AI threads and sessions",
  "license": "MIT",
  "homepage": "https://github.com/hanityx/threadlens",
  "bugs": {
    "url": "https://github.com/hanityx/threadlens/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanityx/threadlens.git"
  },
  "keywords": [
    "electron",
    "observability",
    "ai",
    "providers",
    "sessions",
    "local-first"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.28.0",
      "fastify": "^5.8.5",
      "yauzl": "^3.2.1"
    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @threadlens/shared-contracts build && pnpm --filter @threadlens/api dev",
    "dev:tui": "pnpm --filter @threadlens/tui dev",
    "dev:web": "pnpm --filter @threadlens/web dev",
    "dev:desktop": "ELECTRON_RENDERER_URL=http://127.0.0.1:5174 pnpm --filter @threadlens/desktop-electron dev",
    "dev": "pnpm --filter @threadlens/shared-contracts build && pnpm -r --parallel --filter @threadlens/api --filter @threadlens/web dev",
    "docs:provider-support": "pnpm --filter @threadlens/shared-contracts build && node packages/shared-contracts/provider-support/generate-provider-support.mjs",
    "build": "pnpm --filter @threadlens/shared-contracts build && pnpm --filter @threadlens/api build && pnpm --filter @threadlens/web build",
    "build:tui": "pnpm --filter @threadlens/tui build",
    "start:tui": "pnpm --filter @threadlens/shared-contracts build && pnpm --filter @threadlens/tui exec tsx src/cli.tsx",
    "build:desktop": "pnpm --filter @threadlens/shared-contracts build && pnpm --filter @threadlens/web build && pnpm --filter @threadlens/api bundle:desktop && pnpm --filter @threadlens/desktop-electron build",
    "package:desktop": "pnpm build:desktop && pnpm --filter @threadlens/desktop-electron dist:mac",
    "package:desktop:dir": "pnpm build:desktop && pnpm --filter @threadlens/desktop-electron dist:dir",
    "package:desktop:win": "pnpm build:desktop && pnpm --filter @threadlens/desktop-electron dist:win",
    "package:desktop:linux": "pnpm build:desktop && pnpm --filter @threadlens/desktop-electron dist:linux",
    "test:ci": "pnpm lint && pnpm build && pnpm test && pnpm --filter @threadlens/web test:e2e",
    "test:provider": "pnpm docs:provider-support && pnpm --filter @threadlens/shared-contracts test && pnpm --filter @threadlens/api test && pnpm lint:deps",
    "test:desktop": "pnpm --filter @threadlens/desktop-electron lint && pnpm --filter @threadlens/desktop-electron test && pnpm package:desktop:dir && pnpm --filter @threadlens/desktop-electron smoke:packaged",
    "test:live": "bash tools/qa/web-live-e2e-smoke.sh",
    "test:smoke": "bash tools/qa/gui-pass.sh",
    "test:smoke:tui": "bash tools/qa/tui-smoke.sh",
    "qa:pr": "pnpm test:ci",
    "qa:provider": "pnpm test:provider",
    "qa:desktop": "pnpm test:desktop",
    "qa:live": "pnpm test:live",
    "qa:gui": "pnpm test:smoke",
    "qa:tui": "pnpm test:smoke:tui",
    "smoke:gui": "pnpm test:smoke",
    "smoke:tui": "pnpm test:smoke:tui",
    "test": "pnpm -r test",
    "lint": "pnpm -r --filter @threadlens/shared-contracts --filter @threadlens/api --filter @threadlens/web --filter @threadlens/tui --filter @threadlens/desktop-electron lint && pnpm lint:deps",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps/api-ts/src"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.4.0",
    "typescript": "^6.0.3"
  }
}
